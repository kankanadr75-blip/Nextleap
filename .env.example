# Template for local LLM configuration. Copy to `.env` and fill in.
#     copy .env.example .env
#
# `.env` is git-ignored, so your key is never committed. This file is the
# committed, key-free version. Do not put a real key in here.
#
# ---------------------------------------------------------------------------
# Running with no key at all is fully supported, and is the default.
# ---------------------------------------------------------------------------
# With `LLM_PROVIDER=stub` (or blank) the app uses the offline `StubLLM`, which
# answers extractively from the indexed chunks. The whole test suite, the
# retrieval harness and the Streamlit UI all run this way. No phase of this
# project requires an API key.

# Which LLM generates answers: stub | gemini | groq | openai
LLM_PROVIDER=stub

# Only the provider named in LLM_PROVIDER is read. Leave the rest blank.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Before you trust a key: the app never raises on a bad one
# ---------------------------------------------------------------------------
# A missing key AND a failed API call both fall back to `StubLLM` with only a
# `logger.warning` - by design, so the chat path can never crash. The
# consequence is that a wrong key, an expired key, or a missing `openai`
# package all look like success: you get plausible answers, just not from the
# model you thought you were using.
#
# To check which client is actually live, don't read the answers:
#
#     python -c "from src.query.llm import get_llm; print(get_llm().name)"
#
# or watch for the warnings `... selected but ... is unset; using stub` and
# `... call failed (...); falling back to stub` in the app's terminal.

# ---------------------------------------------------------------------------
# Extra dependencies
# ---------------------------------------------------------------------------
# The `groq` and `openai` providers import the `openai` package, which is
# deliberately NOT in requirements.txt (it is not needed to run anything by
# default). Install it before using either:
#
#     pip install openai
#
# The `gemini` provider uses `requests`, which is already installed, so it is
# the only provider that works with zero extra installs. It is also the easiest
# free tier to start with.

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Model IDs are set in the client classes in `src/query/llm.py` and are not
# configurable from here:
#
#   groq   - llama-3.3-70b-versatile
#   openai - gpt-4o-mini
#   gemini - gemini-1.5-flash
#
# All three are called with temperature 0, and groq/openai request JSON output
# directly. The model is asked for `{"answer", "source_chunk_id"}` and never for
# a URL - the citation comes from the chunk metadata, so a fabricated citation
# is not possible even if the model tries.
